# Resend transactional email — required for the contact form.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxx

# Sender address. In dev you can use the Resend sandbox sender;
# in production use noreply@aldirifai.com (after Resend verifies the domain).
CONTACT_FROM_EMAIL=noreply@aldirifai.com

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=aldirifaiemail@gmail.com

# Public site URL — used for canonical, OG, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://aldirifai.com

# Production marker. docker-compose .env.production should set this; local dev
# can omit (Next sets it automatically based on the script invoked).
NODE_ENV=production
