# Resend transactional email — required for the contact form.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=re_xxx

# Sender address (must be verified in Resend for production).
# In dev you can use the Resend sandbox sender; in prod use noreply@aldirifai.com.
CONTACT_FROM_EMAIL=noreply@aldirifai.com

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=aldirifaiemail@gmail.com

# Public site URL — used for canonical, OG, sitemap, RSS.
NEXT_PUBLIC_SITE_URL=https://aldirifai.com
