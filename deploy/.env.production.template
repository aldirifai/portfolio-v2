# /srv/portfolio/.env.production — VPS production environment.
#
# This file is NOT committed with real values. Copy it to
# /srv/portfolio/.env.production on the VPS and fill the values from:
#
#   • Resend dashboard            — RESEND_API_KEY (https://resend.com/api-keys)
#   • Your domain config          — CONTACT_FROM_EMAIL must be a verified sender
#                                   on the domain you registered in Resend
#   • Your inbox                  — CONTACT_TO_EMAIL where messages land
#
# After updating: `cd /srv/portfolio && docker compose up -d` to reload the
# container with the new environment.
#
# DO NOT commit a filled copy of this file — .gitignore already excludes
# .env.production via the .env* glob.

RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@aldirifai.com
CONTACT_TO_EMAIL=aldirifaiemail@gmail.com
NEXT_PUBLIC_SITE_URL=https://aldirifai.com
NODE_ENV=production
